# StockData pool (T01 collector) — internal service on :15437
STOCKDATA_URL=http://stockdata:15437
STOCKDATA_TIMEOUT=8
# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.pages.dev
# Cache TTL seconds (4h = 14400)
CACHE_TTL=14400
# Sectors v2 market-data gateway (active; keep this file mode 600 — SECTORS_API_KEY must never be committed)
SECTORS_API_KEY=
SECTORS_BASE=https://api.sectors.app/v2
ENV=development
PORT=8000
